{
    "server": {
        "type": "object",
        "description": "图床连接",
        "hint": "配置图床服务的连接信息。",
        "default": {},
        "items": {
            "base_url": {
                "description": "图床网址",
                "type": "string",
                "hint": "用于获取随机图片和上传图片，无需结尾斜杠。",
                "default": "",
                "obvious_hint": true
            },
            "public_base_url": {
                "description": "公网图床网址",
                "type": "string",
                "hint": "可选。当图床使用内网地址时，在此填写对外可访问的 URL，无需结尾斜杠。",
                "default": ""
            },
            "api_token": {
                "description": "API Token",
                "type": "string",
                "hint": "可选，具有上传权限的 API Token。",
                "default": ""
            },
            "auth_code": {
                "description": "认证码",
                "type": "string",
                "hint": "可选，上传 API 的认证码。",
                "default": ""
            }
        }
    },
    "upload": {
        "type": "object",
        "description": "上传设置",
        "hint": "控制上传功能的访问权限与反馈。",
        "default": {},
        "items": {
            "admin_only": {
                "description": "仅管理员可上传",
                "type": "bool",
                "hint": "开启后仅管理员可使用上传功能。",
                "default": true
            },
            "show_link": {
                "description": "上传后显示链接",
                "type": "bool",
                "hint": "开启后上传成功会在消息中显示图片链接。",
                "default": true
            }
        }
    },
    "randomizer": {
        "type": "object",
        "description": "随机获取设置",
        "hint": "控制随机媒体获取的行为与去重逻辑。",
        "default": {},
        "items": {
            "local_random_type": {
                "description": "媒体类型本地随机",
                "type": "bool",
                "hint": "开启且请求包含图片和视频时，在本地随机选取一种类型再请求图床。",
                "default": false
            },
            "dedupe_window": {
                "description": "去重窗口",
                "type": "int",
                "hint": "0 为关闭。每个关键词记录最近 N 次媒体 ID，避免短时间内重复推送。",
                "slider": {
                    "min": 0,
                    "max": 50,
                    "step": 1
                },
                "default": 0
            },
            "dedupe_retry": {
                "description": "去重重试次数",
                "type": "int",
                "hint": "当随机结果命中近期 ID 时，额外重新获取的次数。",
                "slider": {
                    "min": 0,
                    "max": 10,
                    "step": 1
                },
                "default": 2
            }
        }
    },
    "keyword_templates": {
        "type": "template_list",
        "description": "关键词映射",
        "hint": "可为多个关键词绑定同一组文件夹。若与指令映射同名，则以指令映射为准。",
        "templates": {
            "mapping_rule": {
                "name": "映射条目",
                "items": {
                    "keywords": {
                        "description": "关键词列表",
                        "hint": "可填写多个关键词，命中任一关键词时都使用该映射。",
                        "type": "list",
                        "default": []
                    },
                    "folders": {
                        "description": "文件夹列表",
                        "hint": "可填写多个图床文件夹，触发时随机选择其中一个。",
                        "type": "list",
                        "default": []
                    },
                    "content_type": {
                        "description": "内容类型",
                        "type": "string",
                        "hint": "选择该映射允许返回的媒体类型。",
                        "options": [
                            "image,video",
                            "image",
                            "video"
                        ],
                        "labels": [
                            "图片或视频",
                            "仅图片",
                            "仅视频"
                        ],
                        "default": "image,video"
                    }
                }
            }
        },
        "default": []
    }
}
