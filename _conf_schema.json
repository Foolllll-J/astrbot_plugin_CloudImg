{
    "base_url": {
        "description": "图床网址",
        "type": "string",
        "hint": "填写图床网址，用于获取随机图片和上传图片，无需结尾斜杠。",
        "default": "",
        "obvious_hint": true
    },
    "public_base_url": {
        "description": "公网图床网址",
        "type": "string",
        "hint": "可选，仅用于上传成功后显示链接的拼接前缀。当图床网址使用内网地址时，可在此填写对外可访问的 URL，无需结尾斜杠。",
        "default": ""
    },
    "upload_admin_only": {
        "description": "仅管理员可上传",
        "type": "bool",
        "hint": "是否仅允许管理员使用上传功能。",
        "default": true
    },
    "auth_code": {
        "description": "上传认证码",
        "type": "string",
        "hint": "可选，用于上传 API 的认证码。",
        "default": ""
    },
    "show_upload_link": {
        "description": "上传后显示链接",
        "type": "bool",
        "hint": "开启时，上传成功后会在消息中显示返回的图片链接。",
        "default": true
    },
    "local_random_type": {
        "description": "媒体类型本地随机",
        "type": "bool",
        "hint": "若开启且请求包含图片和视频，则在本地随机选取其中一种类型后再请求图床。",
        "default": false
    },
    "keyword_templates": {
        "type": "template_list",
        "description": "关键词映射",
        "hint": "可为多个关键词绑定同一组文件夹。若与指令映射同名，则以指令映射为准。",
        "templates": {
            "mapping_rule": {
                "name": "映射条目",
                "hint": "定义一组关键词对应的文件夹列表与媒体类型。",
                "items": {
                    "keywords": {
                        "description": "关键词列表",
                        "hint": "可填写多个关键词，命中任一关键词时都使用该映射。",
                        "type": "list",
                        "default": []
                    },
                    "folders": {
                        "description": "文件夹列表",
                        "hint": "可填写多个图床文件夹，触发时随机选择其中一个。",
                        "type": "list",
                        "default": []
                    },
                    "content_type": {
                        "description": "内容类型",
                        "hint": "选择该映射允许返回的媒体类型。",
                        "type": "string",
                        "options": [
                            "image,video",
                            "image",
                            "video"
                        ],
                        "labels": [
                            "图片或视频",
                            "仅图片",
                            "仅视频"
                        ],
                        "default": "image,video"
                    }
                }
            }
        },
        "default": []
    },
    "keyword_recent_media_limit": {
        "description": "近期媒体去重窗口",
        "type": "int",
        "hint": "0 为关闭。N>0 时，每个关键词记录最近 N 次媒体 ID。",
        "slider": {
            "min": 0,
            "max": 50,
            "step": 1
        },
        "default": 0
    },
    "keyword_dedupe_retry_limit": {
        "description": "去重重试上限",
        "type": "int",
        "hint": "当新随机结果命中近期 ID 时的额外重试次数。",
        "slider": {
            "min": 0,
            "max": 10,
            "step": 1
        },
        "default": 2
    }
}
